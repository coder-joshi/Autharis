{
  "name": "autharis",
  "version": "1.0.0",
  "description": "A self-hostable identity and authentication platform that gives developers control over how their applications manage users, logins, and identity.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
  "dev": "tsx watch apps/server/src/server.ts",
  "build": "tsc",
  "start": "node dist/apps/server/src/server.js",
  "typecheck": "tsc --noEmit",
  "test": "vitest run",
  "test:watch": "vitest",
  "lint": "eslint .",
  "format": "prettier --write .",
  "format:check": "prettier --check ."
},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coder-joshi/Autharis.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/coder-joshi/Autharis/issues"
  },
  "homepage": "https://github.com/coder-joshi/Autharis#readme",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
